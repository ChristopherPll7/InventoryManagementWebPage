@model CategoryDto
@{ ViewData["Title"] = "Desactivar categoría"; }
<a return-back class="back-link" href="/categories/@Model.Id">← Volver al detalle</a><section class="confirm-card"><span class="overline">CONFIRMACIÓN</span><div class="confirm-symbol" aria-hidden="true">−</div><h1>¿Desactivar “@Model.Name”?</h1><p>La categoría permanecerá visible, pero no podrá asignarse a nuevos productos. Si contiene productos activos, la API rechazará la operación.</p><form preserve-return asp-antiforgery="true" method="post" action="/categories/@Model.Id/deactivate" data-submitting><div class="form-actions"><a return-back class="button button-ghost" href="/categories/@Model.Id">Cancelar</a><button type="submit" class="button button-danger">Sí, desactivar</button></div></form></section>


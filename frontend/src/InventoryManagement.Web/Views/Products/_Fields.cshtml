@model ProductForm
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="form-grid-two"><div class="field"><label asp-for="Name">Nombre <span class="required">*</span></label><input asp-for="Name" data-trim-max="150" required placeholder="Ej. Lámpara de mesa" /><span asp-validation-for="Name" class="field-error"></span></div><div class="field"><label asp-for="Sku">SKU <span class="required">*</span></label><input asp-for="Sku" data-trim-max="80" required autocomplete="off" placeholder="EJ-001" /><span asp-validation-for="Sku" class="field-error"></span></div></div>
<div class="field"><label asp-for="Description">Descripción <span class="optional">Opcional</span></label><textarea asp-for="Description" data-trim-max="1000" rows="4" placeholder="Material, dimensiones o detalles relevantes"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
<div class="form-grid-two"><div class="field"><label asp-for="PriceText">Precio <span class="required">*</span></label><div class="input-prefix"><span>$</span><input asp-for="PriceText" inputmode="decimal" required pattern="[0-9]+([.][0-9]{1,2})?" title="Usa punto y hasta dos decimales" placeholder="0.00" /></div><span asp-validation-for="PriceText" class="field-error"></span><small>Usa punto para los decimales.</small></div><div class="field"><label asp-for="CategoryId">Categoría <span class="required">*</span></label>@if (ViewData["ManualCategory"] is true) { <input asp-for="CategoryId" required placeholder="UUID de la categoría" /><small>No tienes acceso al catálogo. Indica el UUID de una categoría activa; se comprobará al guardar.</small> } else { <select asp-for="CategoryId" required><option value="">Selecciona una categoría</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name@(!category.IsActive ? " · inactiva" : "")</option> }</select> }<span asp-validation-for="CategoryId" class="field-error"></span></div></div>
@if (ViewData["CategoryWarning"] is string warning) { <div class="notice notice-warning" role="alert">@warning</div> }



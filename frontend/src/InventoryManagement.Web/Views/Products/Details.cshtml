@model ProductDetailPage
@inject PermissionService Permissions
@{ var product = Model.Product; ViewData["Title"] = product.Name; }
<a return-back class="back-link" href="/products">← Todos los productos</a>
<div class="page-heading detail-heading"><div><span class="overline">PRODUCTO / @product.Sku</span><h1>@product.Name</h1><span class="status @(product.IsActive ? "status-active" : "status-inactive")">@(product.IsActive ? "Activo" : "Inactivo")</span></div><div class="button-group">@if (await Permissions.HasAsync("inventory.write")) { <a preserve-return class="button" href="/inventory/products/@product.Id/movements">Registrar movimiento</a> }@if (await Permissions.HasAsync("inventory.read")) { <a preserve-return class="button" href="/inventory/products/@product.Id">Ver inventario <span aria-hidden="true">↗</span></a> }@if (await Permissions.HasAsync("products.write")) { <a preserve-return class="button button-ghost" href="/products/@product.Id/edit">Editar</a>@if (product.IsActive) { <a preserve-return class="button button-danger-outline" href="/products/@product.Id/deactivate">Desactivar</a> } }</div></div>
<div class="detail-grid"><section class="detail-card"><span class="overline">FICHA DEL PRODUCTO</span><h2>Información general</h2><dl class="detail-list"><div><dt>Descripción</dt><dd>@(string.IsNullOrEmpty(product.Description) ? "Sin descripción" : product.Description)</dd></div><div><dt>Categoría</dt><dd>@Model.CategoryName</dd></div><div><dt>SKU</dt><dd class="mono">@product.Sku</dd></div><div><dt>Precio unitario</dt><dd>@product.Price.ToString("N2")</dd></div></dl></section><aside class="stock-card"><span class="overline">EXISTENCIA ACTUAL</span><strong>@product.CurrentStock</strong><span>unidades registradas</span>@if (await Permissions.HasAsync("inventory.read")) { <a preserve-return href="/inventory/products/@product.Id">Ver movimientos ↗</a> }</aside></div>



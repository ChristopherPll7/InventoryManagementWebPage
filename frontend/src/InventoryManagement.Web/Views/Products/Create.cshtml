@inject PermissionService Permissions
@{ var returnUrl = await Permissions.HasAsync("products.read") ? "/products" : "/products"; }
@model ProductForm
@{ ViewData["Title"] = "Nuevo producto"; }
<a return-back class="back-link" href="@returnUrl">← Todos los productos</a><div class="form-heading"><span class="overline">CATÁLOGO / NUEVO PRODUCTO</span><h1>Una pieza más.</h1><p>Completa la información. El stock comienza en cero.</p></div>
<div class="form-layout"><form preserve-return asp-antiforgery="true" method="post" action="/products/create" class="form-card" data-submitting><h2>Información del producto</h2><partial name="_Fields" model="Model" /><div class="form-actions"><a return-back class="button button-ghost" href="@returnUrl">Cancelar</a><button class="button" type="submit">Crear producto <span aria-hidden="true">↗</span></button></div></form><aside class="form-aside"><span class="overline">SIGUIENTE PASO</span><p>Después de crear el producto, registra una entrada desde su página de inventario.</p>@if (Model.Categories.Count == 0) { <a href="/categories/create">Crear una categoría primero ↗</a> }</aside></div>


